# Path-based git attributes
# https://www.kernel.org/pub/software/scm/git/docs/gitattributes.html

* text=auto eol=lf

# Keep the compiled SPA out of diffs; it is rebuilt with `npm run build`.
/dist/** -diff linguist-generated

# Ignore development-only files with "export-ignore".
/.agents             export-ignore
/.beads              export-ignore
/.claude             export-ignore
/.codex              export-ignore
/.cursor             export-ignore
/.github             export-ignore
/.editorconfig       export-ignore
/.gitattributes      export-ignore
/.gitignore          export-ignore
/.mcp.json           export-ignore
/AGENTS.md           export-ignore
/CLAUDE.md           export-ignore
/PRD.md              export-ignore
/boost.json          export-ignore
/components.json     export-ignore
/opencode.json       export-ignore
/package.json        export-ignore
/package-lock.json   export-ignore
/phpstan.neon.dist   export-ignore
/phpstan-baseline.neon export-ignore
/phpunit.xml.dist    export-ignore
/pint.json           export-ignore
/resources/js        export-ignore
/testbench.yaml      export-ignore
/tests               export-ignore
/tsconfig.json       export-ignore
/vite.config.ts      export-ignore
/workbench           export-ignore
